{
  "name": "bb-plugin-navaigate-skin",
  "version": "0.35.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "NavAIgate Workspace",
    "description": "Turn bb's sidebar into a run sheet: see what every harness is working on, tag and flag chats, and track to-dos that move on their own.",
    "branding": {
      "icon": "./icons/workspace.svg",
      "experimental_icons": {
        "contrast": "./icons/contrast.svg",
        "board": "./icons/board.svg",
        "guide": "./icons/guide.svg",
        "todo": "./icons/todo.svg",
        "agents": "./icons/agents.svg",
        "dashboard": "./icons/dashboard.svg",
        "workspace": "./icons/workspace.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "themes": [
      {
        "id": "navaigate",
        "name": "NavAIgate",
        "description": "navaigate.dev tokens. White paper and ink, cool greys, one blue for live work.",
        "css": "./themes/navaigate.css",
        "codeTheme": {
          "dark": "vitesse-dark",
          "light": "vitesse-light"
        }
      },
      {
        "id": "ember",
        "name": "Ember",
        "description": "Charcoal surfaces, quiet borders and restrained amber accents. Includes a neutral light mode.",
        "css": "./themes/ember.css",
        "codeTheme": {
          "dark": "vitesse-dark",
          "light": "vitesse-light"
        }
      }
    ],
    "host": "./host-delivery.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.26.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "zod": "^4.3.6"
  },
