# Copy to .env and fill in what you use. Never commit .env.

# The public name your AI clients will use, for example brain.example.com. Needed for a tunnel or a VPS.
# Without it the connector only accepts localhost.
BRAIN_MCP_HOSTS=

# Cloudflare Tunnel (profile "tunnel"): the token from the Cloudflare dashboard.
TUNNEL_TOKEN=

# VPS with Caddy (profile "caddy"): the same name as above, with its DNS A record pointing at the server.
BRAIN_DOMAIN=

# Windows with Docker Desktop only: keep the database in a Docker volume instead of a folder.
# SQLD_DATA=brain_sqld_data

# Host ports on this machine (127.0.0.1 only). Change them if 8090 or 8765 are already taken.
# SQLD_PORT=8090
# MCP_PORT=8765
